# ------------------------------------------------------------------
# AUBE environment
#
# Copy to `.env.local` and fill in. Every value here is optional: with none of
# them set the storefront runs entirely on the mock data layer in `src/data`,
# which is the default and the state of a fresh clone.
# ------------------------------------------------------------------

# Which data layer the services in `src/lib/services` read from.
#   mock      — in-repo content, no network. The default.
#   supabase  — Postgres via Supabase, with the mock as a fallback if unset.
DATA_SOURCE=mock

# ------------------------------------------------------------------
# Supabase
#
# Project settings -> API. Both public values are safe to expose to the
# browser: RLS is what protects the data, not the key.
# ------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Bypasses RLS — use it for admin writes and nothing else.
# Never prefix this with NEXT_PUBLIC_ and never import it in a client
# component; `src/lib/supabase/admin.ts` marks itself `server-only` so a
# mistake fails the build instead of shipping the key.
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------
# Postgres (setup scripts only — the app never connects directly)
#
# Project settings -> Database -> Connection string.
#
# `DIRECT_URL` is the session-mode pooler on 5432 and is what `npm run db:*`
# uses. The transaction-mode pooler on 6543 cannot hold a session, so DDL
# against it fails partway through a migration. `DATABASE_URL` is kept for
# tooling that only needs a pooled connection.
# ------------------------------------------------------------------
DATABASE_URL=
DIRECT_URL=

# ------------------------------------------------------------------
# Admin smoke test credentials (local development only)
#
# `npm run smoke:admin` drives the real sign-in form in a headless browser.
# It needs an account that exists in `admin_users` — create one with
# `npm run db:admin -- <email> "<password>" "<full name>"`.
# Never set these in a deployed environment.
# ------------------------------------------------------------------
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ------------------------------------------------------------------
# Legacy REST API seam
#
# Kept for a future non-Supabase backend. The service layer's `Result<T>`
# contract is shaped so either can be used without touching components.
# ------------------------------------------------------------------
NEXT_PUBLIC_API_URL=
