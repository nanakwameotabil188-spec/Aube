{
  "name": "aube-storefront",
  "version": "0.1.0",
  "private": true,
  "description": "AUBE — premium skincare storefront foundation (Next.js App Router, data-driven, backend-ready).",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "audit:overflow": "node scripts/audit-overflow.mjs",
    "audit:interactions": "node scripts/smoke-interactions.mjs",
    "audit:newsletter": "node scripts/audit-newsletter-contrast.mjs",
    "verify:accounts": "node scripts/verify-accounts.mjs",
    "audit:account": "node scripts/audit-account-source.mjs",
    "audit:account-e2e": "node scripts/smoke-account.mjs",
    "audit:checkout": "node scripts/smoke-checkout.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:seed": "tsx scripts/db-seed.ts",
    "db:status": "node scripts/db-status.mjs",
    "db:check": "node scripts/db-check-policies.mjs",
    "db:admin": "node scripts/db-admin.mjs",
    "db:storage": "node scripts/db-check-storage.mjs",
    "db:setup": "npm run db:migrate && npm run db:seed && npm run db:check && npm run db:storage",
    "smoke:admin": "node scripts/smoke-admin-auth.mjs",
    "smoke:newsletter": "node scripts/smoke-newsletter.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "clsx": "^2.1.1",
    "next": "16.3.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.6",
    "pg": "^8.23.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0"
  }
